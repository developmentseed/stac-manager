{
  "name": "root",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "plugins:watch": "lerna watch --ignore='@stac-manager/client' -- lerna run build --scope=$LERNA_PACKAGE_NAME --ignore='@stac-manager/client'",
    "plugins:build": "lerna run build --ignore='@stac-manager/client'",
    "plugins:clean": "lerna run clean --ignore='@stac-manager/client'",
    "client:serve": "lerna run serve --scope='@stac-manager/client'",
    "client:build": "lerna run build --scope='@stac-manager/client'",
    "client:stage": "lerna run stage --scope='@stac-manager/client'",
    "all:build": "lerna run build",
    "all:clean": "lerna run clean",
    "test": "jest",
    "lint": "lerna run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@types/testing-library__jest-dom": "^5.14.9",
    "babel-jest": "^30.5.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lerna": "^10.1.1",
    "prettier": "^3.3.3",
    "rollup": "^4.24.2",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-import-css": "^4.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.37.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.1"
  },
  "//": "overrides.nx.undici: nx 23 pins undici 7.29.0 and lerna 10 caps nx below 24. Remove once lerna accepts nx >=24.0.3.",
  "overrides": {
    "nx": {
      "undici": "^7.30.1"
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
